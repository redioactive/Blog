{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "importHelpers": true,
    "declaration": true,                // 启用生成声明文件
    "declarationDir": "./src/types",       // 指定声明文件的输出目录
    "moduleResolution": "node",
    /** TS严格模式 */
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["esnext","dom"],
    "skipLibCheck": true,
    "types:": [
      "node",
      "vite/client",
      "vitest"
    ],
    /** baseUrl 用来告诉编译器到哪里去查找模块，使用非相对模块时必须配置此项*/
    "baseUrl": ".",
    /**非相对模块导入路径映射配置，根据 baseUrl 配置进行路径计算 */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "types/env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts",
    "types/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  //编译器默认排除的编译文件
  "exclude": ["src/**/__tests__/*"]
}